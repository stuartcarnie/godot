{
  "version": 10,
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macos (Editor)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/xcode",
      "environment": {
        "MOLTENVK_SDK": "/Volumes/Data/SDKs/VulkanSDK/1.4.341.1/macOS/lib"
      },
      "cacheVariables": {
        "APPLE_BUNDLE_IDENTIFIER": "org.stuartcarnie.godot",
        "DEV_BUILD_LEVEL": "debug",
        "ENABLE_RETROFX": true
      }
    },
    {
      "hidden": true,
      "name": "apple-embedded-xcode",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_FRAMEWORK_PATH": "/Volumes/Data/SDKs/VulkanSDK/1.4.341.1/macOS/lib",
        "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "BOTH",
        "APPLE_BUNDLE_IDENTIFIER": "org.stuartcarnie.godot",
        "DEV_BUILD_LEVEL": "none",
        "ARCHS": "arm64"
      }
    },
    {
      "name": "visionos",
      "displayName": "visionOS (Window)",
      "generator": "Xcode",
      "toolchainFile": "cmake/toolchains/visionos.cmake",
      "binaryDir": "${sourceDir}/xcode-visionos",
      "cacheVariables": {
        "VISIONOS_APP_ROLE": "window",
        "APPLE_BUNDLE_IDENTIFIER": "org.stuartcarnie.godot",
        "DEV_BUILD_LEVEL": "all",
        "GODOT_TARGET": "template_debug"
      }
    },
    {
      "name": "visionos-immersive",
      "displayName": "visionOS (Immersive)",
      "inherits": "visionos",
      "cacheVariables": {
        "VISIONOS_APP_ROLE": "immersive",
        "VISIONOS_IMMERSION_STYLE": "mixed"
      }
    },
    {
      "inherits": ["apple-embedded-xcode"],
      "name": "ios-xcode",
      "displayName": "iOS (Xcode)",
      "generator": "Xcode",
      "toolchainFile": "cmake/toolchains/ios.cmake",
      "binaryDir": "${sourceDir}/xcode-ios",
      "cacheVariables": {
        "GODOT_TARGET": "template_debug"
      }
    }
  ]
}
