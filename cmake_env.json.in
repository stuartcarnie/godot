{
    "platform" : "@GODOT_PLATFORM@",
    "arch" : "@OS_ARCH@",
    "editor_build": @EDITOR_BUILD@,
    "modules_enabled_by_default" : true,
    "disable_3d" : false,
    "disable_physics_2d": @DISABLE_PHYSICS_2D_B@,
    "disable_physics_3d": @DISABLE_PHYSICS_3D_B@,
    "disable_navigation_2d": @DISABLE_NAVIGATION_2D_B@,
    "disable_navigation_3d": @DISABLE_NAVIGATION_3D_B@,
    "disable_xr": @DISABLE_XR_B@,
    "vulkan" : @WANT_VULKAN_B@,
    "d3d12" : false,
    "metal" : @WANT_METAL_B@,
    "openxr" : @WANT_OPENXR_B@,
    "module_retrofx_enabled": @WANT_RETROFX_B@,
    "opengl3" : true,
    "minizip" : true,
    "builtin_certs" : true,
    "system_certs_path" : ""
}
